// Controls shared by the settings, wizard and tunnel form windows (docs/design/ui-handoff.md,
// sections 2, 7 and 8, and the dark addendum). Built from Rectangle, Text, TextInput, Path and
// TouchArea only; every colour comes from `Theme`, every text from `Words`, which the app fills
// for each window from the catalog.

import { Theme, Mark, StateMark } from "main.slint";

// The texts of the new windows. Each window has its own copy, filled by the app.
export global Words {
    in-out property <string> settings-title;
    in-out property <string> nav-tunnels;
    in-out property <string> nav-help;
    in-out property <string> nav-about;
    in-out property <string> section-tunnels;
    in-out property <string> section-pcs;
    in-out property <string> add-tunnel;
    in-out property <string> add-pc;
    in-out property <string> edit;
    in-out property <string> delete;
    in-out property <string> delete-confirm;
    in-out property <string> help-empty;
    in-out property <string> about-name;
    in-out property <string> about-description;
    in-out property <string> about-slint;
    in-out property <string> about-font;
    in-out property <string> about-license;
    in-out property <string> field-name;
    in-out property <string> tunnel-field-conf;
    in-out property <string> tunnel-hint-conf;
    in-out property <string> tunnel-field-probe;
    in-out property <string> tunnel-hint-probe;
    in-out property <string> save;
    in-out property <string> cancel;
    in-out property <string> back;
    in-out property <string> next;
    in-out property <string> finish;
    in-out property <string> field-host;
    in-out property <string> field-ports;
    in-out property <string> hint-ports;
    in-out property <string> tunnel-none;
    in-out property <string> wake-none;
    in-out property <string> wake-relay;
    in-out property <string> wake-magic;
    in-out property <string> wake-command;
    in-out property <string> relay-label;
    in-out property <string> relay-new;
    in-out property <string> relay-routeros;
    in-out property <string> relay-etherwake;
    in-out property <string> relay-wakeonlan;
    in-out property <string> field-mac;
    in-out property <string> field-interface;
    in-out property <string> field-address;
    in-out property <string> hint-address;
    in-out property <string> magic-routed-help;
    in-out property <string> field-port;
    in-out property <string> field-user;
