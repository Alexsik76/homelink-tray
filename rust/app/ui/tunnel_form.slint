// The add/edit tunnel form. There is no design for it: it uses the wizard's header, body and
// footer, the same controls, and no progress bars. The technical fields of a tunnel (the
// WireGuard path, the timeouts) are kept by the app and not shown.

import { Theme } from "main.slint";
import { Words, Flow, Btn, BtnKind, Field, Divider, RadioRow } from "controls.slint";

export component TunnelFormWindow inherits Window {
    // The header: "Додати тунель", or "Змінити тунель <name>".
    in property <string> heading;
    in-out property <string> name;
    // The tunnels imported into the WireGuard client (from its Configurations folder), as
    // labels; the one chosen, -1 for none. Choosing one fills the name.
    in property <[string]> tunnel-labels;
    in-out property <int> tunnel-index: -1;
    // Shown instead of the list when the client has no imported tunnel.
    in property <string> tunnels-empty;
    // The problems by field: 0 name, 1 tunnel, 2 (unused).
    in property <[string]> errors;
    // A failure of the save that no field shows.
    in property <string> general-error;
    // The WireGuard client was not found: the red block, inactive fields, "Зберегти" inactive and
    // "Перевірити знову" (artboard `TunnelForm`; the only place a missing tool is shown in red).
    in property <bool> wireguard-missing;
    in property <string> missing-title;
    in property <string> missing-body;
    in property <string> install-label;
    in property <string> install-url;
    in property <string> capabilities-label;

    callback cancel();
    callback tunnel-chosen(int);
    callback recheck();
    callback open-link(string);
    callback open-capabilities();

    title: Words.about-name + " — " + root.heading;
    icon: @image-url("icons/app.png");
    width: 420px;
    height: (root.wireguard-missing ? 520px : 400px) + max(0, root.tunnel-labels.length - 2) * 32px;
    background: Theme.bg;
    default-font-family: "Inter";
    default-font-size: 13px;

    VerticalLayout {
        Rectangle {
            height: 40px;
            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding-left: 16px;
                padding-right: 16px;
                Text {
                    text: root.heading;
                    color: Theme.ink;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Divider {
                y: parent.height - 1px;
                width: parent.width;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 20px;
            spacing: 16px;
            alignment: start;

            if root.wireguard-missing : Rectangle {
                border-width: 1px;
                border-color: Theme.state-fail;
                background: Theme.surface;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    Text {
                        width: parent.width - 24px;
                        text: root.missing-title;
                        color: Theme.state-fail;
                        font-size: 13px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Text {
                        width: parent.width - 24px;
                        text: root.missing-body;
                        color: Theme.ink-2;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: root.install-label;
                            color: install-ta.has-hover ? Theme.link-hover : Theme.link;
                            font-size: 12px;
                            install-ta := TouchArea {
                                clicked => { root.open-link(root.install-url); }
                            }
                        }
                        Text {
                            text: "·";
                            color: Theme.muted;
                            font-size: 12px;
                        }
                        Text {
                            text: root.capabilities-label;
                            color: caps-ta.has-hover ? Theme.link-hover : Theme.link;
                            font-size: 12px;
                            caps-ta := TouchArea {
                                clicked => { root.open-capabilities(); }
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Text {
                    text: Words.tunnel-field-conf;
                    color: root.wireguard-missing ? Theme.disabled : Theme.ink;
                    font-size: 12px;
                    font-weight: 600;
                }
                if root.tunnel-labels.length == 0 && !root.wireguard-missing : Text {
                    width: parent.width;
                    text: root.tunnels-empty;
                    color: Theme.ink-2;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle {
                    border-width: root.tunnel-labels.length > 0 ? 1px : 0px;
                    border-color: root.errors[1] != "" ? Theme.state-fail : Theme.line;
                    VerticalLayout {
                        for label[i] in root.tunnel-labels : RadioRow {
                            label: label;
                            selected: root.tunnel-index == i;
                            clicked => {
                                if (!root.wireguard-missing) {
                                    root.tunnel-index = i;
                                    root.tunnel-chosen(i);
                                }
                            }
                        }
                    }
                }
                Text {
                    width: parent.width;
                    text: root.errors[1] != "" ? root.errors[1] : Words.tunnel-hint-conf;
                    color: root.errors[1] != "" ? Theme.state-fail : Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
            Field {
                label: Words.field-name;
                enabled: !root.wireguard-missing;
                value <=> root.name;
                error: root.errors[0];
            }
            if root.general-error != "" : Text {
                text: root.general-error;
                color: Theme.state-fail;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        Rectangle {
            height: 56px;
            Divider {
                width: parent.width;
            }
            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 12px;
                spacing: 8px;
                alignment: end;
                if root.wireguard-missing : Btn {
                    label: Words.recheck;
                    kind: BtnKind.secondary;
                    clicked => { root.recheck(); }
                }
                Btn {
                    label: Words.cancel;
                    kind: BtnKind.secondary;
                    clicked => { root.cancel(); }
                }
                Btn {
                    label: Words.save;
                    kind: BtnKind.primary;
                    available: !root.wireguard-missing;
                    clicked => { if (!root.wireguard-missing) { Flow.advance(); } }
                }
            }
        }
    }
}
