// The settings window (docs/design/ui-handoff.md, section 7; dark addendum section 3). A plain
// window with the system frame: a navigation column and three pages. The lists and the delete
// confirmation are driven by the app; the page only shows what it is given.

import { Theme, StateMark, Mark } from "main.slint";
import { Words, Btn, BtnKind, Divider, VScroll } from "controls.slint";

// One row of a list: the id is sent back with the actions.
export struct SettingsRow {
    id: string,
    name: string,
    secondary: string,
    // The delete button of this row waits for its confirmation.
    armed: bool,
}

// One tile of the capabilities page (artboard `Capabilities`).
export struct CapabilityTile {
    title: string,
    found: bool,
    line: string,
    // The folder or the paths where the programs were found, a line each; empty when missing.
    details: [string],
    link-label: string,
    link-url: string,
}

// A navigation item: 36 high; the selected one has a bg fill and a 3 px ink bar on its left edge.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 36px;
    background: root.selected ? Theme.bg : (ta.has-hover ? Theme.hover : transparent);

    if root.selected : Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: parent.height;
        background: Theme.ink;
    }
    Text {
        x: 16px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.label;
        color: Theme.ink;
        font-size: 13px;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A row of a list: 36 high, the name (13/600), the secondary text (12/400 muted), and the text
// buttons "Змінити" (edit) and "Видалити" (delete, which asks again when armed).
component ListRow inherits Rectangle {
    in property <string> name;
    in property <string> secondary;
    in property <bool> armed;
    callback edit();
    callback remove();

    height: 44px;
    background: transparent;

    // The name and its note on the left; "Змінити" and "Видалити" as bordered buttons on the
    // right (as text they did not read as buttons). A delete waiting for its confirmation says
    // so on the button.
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: root.name;
            color: Theme.ink;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.secondary;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Btn {
                kind: BtnKind.compact;
                label: Words.edit;
                clicked => {
                    root.edit();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                kind: BtnKind.compact;
                label: root.armed ? Words.delete-confirm : Words.delete;
                tone: Theme.state-fail;
                clicked => {
                    root.remove();
                }
            }
        }
    }
}

// A section title with its add button on the right (the button is 28 high).
component SectionHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> button;
    callback add();
    height: 28px;
    alignment: space-between;
    Text {
        text: root.title;
        color: Theme.ink;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Btn {
        label: root.button;
        height: 28px;
        clicked => {
            root.add();
        }
    }
}

export component SettingsWindow inherits Window {
    in property <[SettingsRow]> tunnels;
    in property <[SettingsRow]> pcs;
    // Shown under the lists while a delete waits for its confirmation.
    in property <string> armed-hint;
    // The refusal or the failure of the last change, in state-fail.
    in property <string> page-error;
    in property <image> glyph;
    in property <string> version-text;
    in property <string> slint-version;
    in property <string> slint-url;
    // The text of the third-party notices (page 3).
    in property <string> notices;
    // The tiles of the capabilities page and the time of the last lookup.
    in property <[CapabilityTile]> capability-tiles;
    in property <string> capabilities-checked;
    // The page: 0 tunnels and PCs, 1 help, 2 about, 3 third-party notices (opened from about),
    // 4 system capabilities.
    in-out property <int> page: 0;

    callback add-tunnel();
    callback add-pc();
    callback edit-tunnel(string);
    callback edit-pc(string);
    callback delete-tunnel(string);
    callback delete-pc(string);
    // Any click on the page that is not one of its buttons cancels a waiting delete.
    callback disarm();
    callback open-link(string);
    // "Перевірити знову" on the capabilities page.
    callback recheck();

    title: Words.about-name + " — " + Words.settings-title;
    icon: @image-url("icons/app.png");
    width: 720px;
    height: 480px;
    background: Theme.bg;
    default-font-family: "Inter";
    default-font-size: 13px;

    HorizontalLayout {
        Rectangle {
            width: 180px;
            background: Theme.bg-side;
            VerticalLayout {
                padding-top: 8px;
                alignment: start;
                NavItem {
                    label: Words.nav-tunnels;
                    selected: root.page == 0;
                    clicked => { root.page = 0; root.disarm(); }
                }
                NavItem {
                    label: Words.nav-capabilities;
                    selected: root.page == 4;
                    clicked => { root.page = 4; root.disarm(); }
                }
                NavItem {
                    label: Words.nav-help;
                    selected: root.page == 1;
                    clicked => { root.page = 1; root.disarm(); }
                }
                NavItem {
                    label: Words.nav-about;
                    selected: root.page == 2 || root.page == 3;
                    clicked => { root.page = 2; root.disarm(); }
                }
            }
            Rectangle {
                x: parent.width - 1px;
                y: 0px;
                width: 1px;
                height: parent.height;
                background: Theme.line;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.disarm(); }
            }

            // Tunnels and PCs. The list scrolls with its own bar at the right.
            if root.page == 0 : Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;

                flick := Flickable {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    content-width: parent.width;
                    content-height: pages.preferred-height;

                    // Behind the lists, so that a click on the blank page cancels a waiting delete.
                    TouchArea {
                        width: parent.width;
                        height: pages.preferred-height;
                        clicked => { root.disarm(); }
                    }

                    pages := VerticalLayout {
                        padding: 16px;
                        spacing: 20px;
                        width: parent.width;

                        VerticalLayout {
                            spacing: 8px;
                            SectionHead {
                                title: Words.section-tunnels;
                                button: Words.add-tunnel;
                                add => { root.disarm(); root.add-tunnel(); }
                            }
                            if root.tunnels.length > 0 : Rectangle {
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.line;
                                VerticalLayout {
                                    for row[i] in root.tunnels : VerticalLayout {
                                        if i > 0 : Divider {}
                                        ListRow {
                                            name: row.name;
                                            secondary: row.secondary;
                                            armed: row.armed;
                                            edit => { root.disarm(); root.edit-tunnel(row.id); }
                                            remove => { root.delete-tunnel(row.id); }
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;
                            SectionHead {
                                title: Words.section-pcs;
                                button: Words.add-pc;
                                add => { root.disarm(); root.add-pc(); }
                            }
                            if root.pcs.length > 0 : Rectangle {
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.line;
                                VerticalLayout {
                                    for row[i] in root.pcs : VerticalLayout {
                                        if i > 0 : Divider {}
                                        ListRow {
                                            name: row.name;
                                            secondary: row.secondary;
                                            armed: row.armed;
                                            edit => { root.disarm(); root.edit-pc(row.id); }
                                            remove => { root.delete-pc(row.id); }
                                        }
                                    }
                                }
                            }
                        }

                        if root.armed-hint != "" : Text {
                            width: parent.width - 32px;
                            text: root.armed-hint;
                            color: Theme.ink-2;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if root.page-error != "" : Text {
                            width: parent.width - 32px;
                            text: root.page-error;
                            color: Theme.state-fail;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                VScroll {
                    x: parent.width - 8px;
                    y: 0px;
                    height: parent.height;
                    view-height: flick.height;
                    content-height: flick.content-height;
                    offset: -flick.content-y;
                    scroll-to(amount) => { flick.content-y = -amount; }
                }
            }

            // System capabilities (artboard `Capabilities`): a header with the time of the last
            // lookup and "Перевірити знову", then two columns of tiles. A missing program is shown
            // neutrally: muted title, outline marker, no red.
            if root.page == 4 : Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;

                caps-flick := Flickable {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    content-width: parent.width;
                    content-height: caps-page.preferred-height;

                    caps-page := VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        width: parent.width;

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: Words.nav-capabilities;
                                color: Theme.ink;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.capabilities-checked;
                                color: Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Btn {
                                label: Words.recheck;
                                clicked => { root.recheck(); }
                            }
                        }

                        for pair in [0, 2, 4, 6] : HorizontalLayout {
                            spacing: 8px;
                            // Each tile is half the row (with stretch, a tile with a longer path took
                            // more of it).
                            for i in [pair, pair + 1] : Rectangle {
                                width: (parent.width - 8px) / 2;
                                min-height: tile.preferred-height;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.line;
                                property <CapabilityTile> item: root.capability-tiles[i];
                                visible: i < root.capability-tiles.length;
                                tile := VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    // A shorter tile keeps its content at the top of the row.
                                    alignment: start;
                                    Text {
                                        text: item.title;
                                        color: item.found ? Theme.ink : Theme.muted;
                                        font-size: 13px;
                                        font-weight: 600;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: start;
                                            padding-top: 4px;
                                            StateMark {
                                                mark: item.found ? Mark.ok : Mark.unknown;
                                            }
                                        }
                                        Text {
                                            text: item.line;
                                            color: item.found ? Theme.ink : Theme.ink-2;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    // One path per line (programs of one tile may be in different folders),
                                    // each shortened at the end when it is too long.
                                    for path in item.details : Text {
                                        text: path;
                                        color: Theme.muted;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                    if item.link-url != "" : Rectangle {
                                        height: 18px;
                                        HorizontalLayout {
                                            alignment: start;
                                            cap-link := Text {
                                                text: item.link-label;
                                                color: cap-ta.has-hover ? Theme.link-hover : Theme.link;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        cap-ta := TouchArea {
                                            width: cap-link.preferred-width;
                                            height: parent.height;
                                            x: 0px;
                                            clicked => { root.open-link(item.link-url); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                VScroll {
                    x: parent.width - 8px;
                    y: 0px;
                    height: parent.height;
                    view-height: caps-flick.height;
                    content-height: caps-flick.content-height;
                    offset: -caps-flick.content-y;
                    scroll-to(amount) => { caps-flick.content-y = -amount; }
                }
            }

            // Help (not designed: section titles and texts in the list styles), scrolling like
            // the lists.
            if root.page == 1 : Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;

                help-flick := Flickable {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    content-width: parent.width;
                    content-height: help-page.preferred-height;

                    help-page := VerticalLayout {
                        padding: 16px;
                        spacing: 16px;
                        width: parent.width;

                        for section in Words.help : VerticalLayout {
                            spacing: 6px;
                            Text {
                                width: parent.width;
                                text: section.title;
                                color: Theme.ink;
                                font-size: 13px;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                            Text {
                                width: parent.width;
                                text: section.body;
                                color: Theme.ink-2;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                VScroll {
                    x: parent.width - 8px;
                    y: 0px;
                    height: parent.height;
                    view-height: help-flick.height;
                    content-height: help-flick.content-height;
                    offset: -help-flick.content-y;
                    scroll-to(amount) => { help-flick.content-y = -amount; }
                }
            }

            // About (section 7): the glyph, the name, the version, the description and the
            // licence block.
            if root.page == 2 : VerticalLayout {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                spacing: 8px;
                alignment: start;

                Image {
                    width: 48px;
                    height: 48px;
                    source: root.glyph;
                    image-fit: contain;
                }
                Text {
                    text: Words.about-name;
                    color: Theme.ink;
                    font-size: 16px;
                    font-weight: 600;
                }
                Text {
                    text: root.version-text;
                    color: Theme.muted;
                    font-size: 12px;
                }
                Text {
                    width: parent.width;
                    text: Words.about-description;
                    color: Theme.ink-2;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                Text {
                    text: Words.about-slint;
                    color: Theme.ink-2;
                    font-size: 13px;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: root.slint-version;
                        color: Theme.ink-2;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: link.preferred-width;
                        height: 18px;
                        link := Text {
                            text: root.slint-url;
                            color: ta-link.has-hover ? Theme.link-hover : Theme.link;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        ta-link := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.open-link(root.slint-url); }
                        }
                    }
                }
                Text {
                    width: parent.width;
                    text: Words.about-font;
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: Words.about-license;
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle {
                    width: notices-link.preferred-width;
                    height: 18px;
                    notices-link := Text {
                        text: Words.about-third-party;
                        color: notices-ta.has-hover ? Theme.link-hover : Theme.link;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    notices-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.page = 3; root.disarm(); }
                    }
                }
            }

            // Third-party notices (page 3): read only, under a header with the back button. The
            // text scrolls with its own bar at the right.
            if root.page == 3 : VerticalLayout {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                height: parent.height - 32px;
                spacing: 12px;

                HorizontalLayout {
                    height: 28px;
                    alignment: space-between;
                    Text {
                        text: Words.notices-title;
                        color: Theme.ink;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Btn {
                        label: Words.back;
                        height: 28px;
                        clicked => { root.page = 2; }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;

                    notices-flick := Flickable {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        content-width: parent.width;
                        content-height: notices-text.preferred-height;

                        notices-text := Text {
                            x: 0px;
                            y: 0px;
                            width: notices-flick.width - 12px;
                            text: root.notices;
                            color: Theme.ink-2;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    VScroll {
                        x: parent.width - 8px;
                        y: 0px;
                        height: parent.height;
                        view-height: notices-flick.height;
                        content-height: notices-flick.content-height;
                        offset: -notices-flick.content-y;
                        scroll-to(amount) => { notices-flick.content-y = -amount; }
                    }
                }
            }
        }
    }
}
